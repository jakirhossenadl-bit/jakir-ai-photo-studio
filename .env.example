# Frontend: set this to your separately hosted API URL when backend hosting is configured.
# Example: VITE_API_BASE_URL=https://your-api.example.com
VITE_API_BASE_URL=

# Backend-only settings for running the Express server outside Netlify.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_EMAIL=
ADMIN_PASSWORD=
CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
